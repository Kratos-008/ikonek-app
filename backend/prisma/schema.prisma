generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  YOUTH
  ADMIN
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           UserRole        @default(YOUTH)

  age            Int?
  sex            String?
  address        String?
  cellLeader     String?
  category       String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  prayerRequests PrayerRequest[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PrayerRequest {
  id        String   @id @default(cuid())
  userId    String?
  content   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}